{
  "domain": {
    "default_language": "zh-CN",
    "allowed_article_types": [
      "scenario-tutorial",
      "beginner-guide",
      "use-case",
      "problem-solution",
      "ordinary-person-news",
      "practical-opinion"
    ]
  },
  "audience": {
    "default": ["普通上班族", "普通 AI 用户"],
    "technical_depth": 1
  },
  "trends": {
    "window": "72h",
    "fallback_window": "7d",
    "cache_minutes": 60,
    "default_top_n": 10,
    "enabled_sources": ["official", "xiaohongshu", "zhihu", "weibo", "douyin", "bilibili", "wechat", "toutiao", "juejin", "36kr", "reddit", "x", "github", "hackernews", "producthunt"],
    "cache_dir": ".cache/trends"
  },
  "workflow": {
    "max_detector_iterations": 3,
    "local_lint_revise_below": 78,
    "preserve_facts": true,
    "preserve_code": true,
    "preserve_urls": true,
    "preserve_versions": true,
    "allow_invented_first_person_experience": false
  },
  "zhuque": {
    "enabled": false,
    "endpoint": "https://ai-gateway.edgeone.link/v1/providers/zhuque-text/classify",
    "api_key_env": "ZHUQUE_API_KEY",
    "is_merge": false,
    "timeout_seconds": 30,
    "internal_gate": {
      "min_human_ratio": 0.7,
      "max_ai_ratio": 0.15,
      "max_suspected_ratio": 0.25
    }
  }
}
